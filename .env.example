# Copy to .env and fill in. .env is gitignored.

# --- Anthropic API key -------------------------------------------------------
# Optional here. Preferred route is the task pane's Settings panel, which stores
# the key in the macOS Keychain instead of a plaintext file. This env var is
# still read as a fallback.
# ANTHROPIC_API_KEY=sk-ant-...

# Where a key entered in the task pane gets stored: keychain (default on macOS)
# or file (a 0600 .credentials file next to this one).
# CREDENTIAL_STORE=keychain

# --- Obsidian ----------------------------------------------------------------
# Absolute path to the vault root (defaults to ~/Obsidian). Every route in
# routes.json is relative to it.
OBSIDIAN_VAULT_PATH=/path/to/your/Obsidian
# Defaults to routes.json in the repo root. Point it elsewhere to keep your
# routing table outside the checkout.
# ROUTES_FILE=/path/to/routes.json

# --- Models ------------------------------------------------------------------
# Seed values only. Once you change anything in the task pane's Settings panel,
# config.local.json takes over and these are ignored.
# EXTRACTOR_MODEL=claude-sonnet-5
# ROUTER_MODEL=claude-haiku-4-5
# WRITER_MODEL=claude-haiku-4-5

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Office add-ins require HTTPS, even on localhost. Generated by:
#   npx --yes office-addin-dev-certs install
# run.sh already defaults to these paths; set them only if yours differ.
# SSL_CERTFILE=$HOME/.office-addin-dev-certs/localhost.crt
# SSL_KEYFILE=$HOME/.office-addin-dev-certs/localhost.key

# Origins allowed to call the API (localhost is always allowed).
# ALLOWED_ORIGINS=https://outlook.office.com,https://outlook.office365.com,https://outlook.live.com
